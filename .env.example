# Copia este archivo como .env y completa tus propios valores.
# El archivo .env NUNCA debe subirse al repositorio.

# Configuración del servidor
PORT=3000

# Configuración de MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=personas_db

# Clave secreta para JWT (obligatoria). Genera una con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=2h

# Usuario administrador inicial (opcional). Si se dejan vacíos, no se crea.
ADMIN_USERNAME=
ADMIN_PASSWORD=
